{
  "name": "zylem-monorepo",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Zylem game library monorepo - TypeScript 2025 Edition",
  "license": "MIT",
  "author": "Tim Cool",
  "repository": {
    "type": "git",
    "url": "https://github.com/zylem-game-lib/zylem.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "dev:lib": "pnpm --filter @zylem/game-lib dev",
    "build:lib": "pnpm --filter @zylem/game-lib build",
    "build": "sh ./scripts/build.sh",
    "build:production": "cross-env NODE_ENV=production pnpm -r run build",
    "build:production:verify": "bash ./scripts/ci-production-verify.sh",
    "test": "sh ./scripts/test.sh",
    "coverage": "pnpm --filter @zylem/game-lib coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "deps:latest": "sh ./scripts/deps-latest.sh",
    "install:all": "pnpm install",
    "publish": "sh ./scripts/publish.sh",
    "publish:lib": "sh ./scripts/publish.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@clack/prompts": "^1.6.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "baseline-browser-mapping": "^2.10.44",
    "cross-env": "^10.1.0",
    "npm-check-updates": "^23.1.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.0.8",
    "vite-plugin-glsl": "^1.5.6"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@dgreenheck/three-pinata": "^2.0.1",
    "@zylem/behaviors": "^0.8.8",
    "esbuild": "^0.27.7",
    "mitt": "^3.0.1",
    "multithreading": "^0.3.52"
  }
}
