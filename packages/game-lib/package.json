    "interactive"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --experimental-strip-types ../../../simulation/packages/behaviors/scripts/sync-genre-entries.ts && NODE_OPTIONS=--max-old-space-size=8192 tsup && pnpm api:extract && pnpm api:typedoc && pnpm schema:emit",
    "dev": "tsup --watch",
    "api:extract": "mkdir -p dist/api temp && api-extractor run --local --verbose",
    "api:typedoc": "mkdir -p dist/api && typedoc --options typedoc.json",
    "schema:emit": "node --experimental-strip-types ./scripts/emit-json-schemas.ts",
    "prepublishOnly": "NODE_ENV=production pnpm build",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --reporter=verbose",
    "coverage": "vitest run --coverage",
    "zw:postunlink": "pnpm -w run deps:latest",
    "zw:prerelease": "pnpm -w run deps:latest --check",
    "test:navigation:bundle": "node tests/navigation-bundle.mjs"
  },
