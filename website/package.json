{
  "name": "@zylem/website",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "gen:api": "typedoc && node ./scripts/escape-api-md.mjs",
    "start": "pnpm gen:api && docusaurus start",
    "build": "pnpm gen:api && docusaurus build",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "typecheck:snippets": "tsc --noEmit -p tsconfig.snippets.json",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@mdx-js/react": "^3.1.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/node": "^20.19.43",
    "@zylem/game-lib": "workspace:*",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "raw-loader": "^4.0.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
